{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "description": "Norther Harier backend API (Express + Sequelize + PostgreSQL)",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "lint": "eslint .",
    "test": "vitest run",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:seed": "sequelize-cli db:seed:all",
    "db:reset": "sequelize-cli db:migrate:undo:all && sequelize-cli db:migrate && sequelize-cli db:seed:all",
    "db:test:reset": "sequelize-cli db:migrate:undo:all --env test && sequelize-cli db:migrate --env test",
    "db:prod:status": "sequelize-cli db:migrate:status --env production",
    "db:prod:migrate": "sequelize-cli db:migrate --env production",
    "db:prod:seed": "sequelize-cli db:seed:all --env production",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.0.13",
    "pg": "^8.23.1",
    "pg-hstore": "^2.3.4",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "razorpay": "^2.9.8",
    "sanitize-html": "^2.18.0",
    "sequelize": "^6.37.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.9",
    "sequelize-cli": "^6.6.5",
    "supertest": "^7.3.0",
    "vitest": "^5.0.3"
  }
}
