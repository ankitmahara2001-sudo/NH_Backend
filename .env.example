# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=5000

# Local PostgreSQL (your own install)
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/norther_harier_dev
TEST_DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/norther_harier_test

# Comma-separated origins allowed to call the API with cookies
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Leave empty locally; in production e.g. .northerharier.com
COOKIE_DOMAIN=

# Long random strings (e.g. `openssl rand -hex 32`)
JWT_CUSTOMER_SECRET=
JWT_ADMIN_SECRET=

# Seeded admin account (used only by the seeder)
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-strong-password

# Razorpay (test mode keys locally)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Cloudinary (free plan)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_ROOT_FOLDER=norther-harier

# Email. Set BREVO_API_KEY to send through Brevo's HTTPS API (needed where SMTP ports are
# blocked, e.g. Render's free plan; MAIL_FROM_ADDRESS must be a verified Brevo sender).
# Otherwise the company mail account (SMTP) below is used.
BREVO_API_KEY=
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_NAME=Norther Harier
MAIL_FROM_ADDRESS=
ADMIN_NOTIFY_EMAIL=
# true = print emails to the console instead of sending (development only)
MAIL_DEV_LOG=true

# Public website URL, used in email links
SITE_URL=http://localhost:3000
